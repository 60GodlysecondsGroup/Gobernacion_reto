# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# El .env real NUNCA se versiona. No pongas aquí datos reales de usuarios.

# ── Backend ──────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=4000
# Orígenes permitidos por CORS (separados por coma). Solo el frontend local.
FRONTEND_ORIGIN=http://localhost:3000
# debug | info | warn | error | silencioso
LOG_LEVEL=info

# PostgreSQL. En Supabase usa el pooler en modo sesión (puerto 5432), sin "?sslmode=...".
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres
# disable (Postgres local) | require (cifrado, sin verificar certificado) | verify-full
DATABASE_SSL=require

# ── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
