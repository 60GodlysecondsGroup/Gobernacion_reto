# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# El .env real NUNCA se versiona. No pongas aquí datos reales de usuarios.

# ── Backend ──────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=4000
# Orígenes permitidos por CORS (separados por coma). Ej: http://localhost:3000,https://gobernacion-reto-i8so.vercel.app
# En Vercel (vercel.json) los dominios *.vercel.app del despliegue ya se aceptan: aquí solo un dominio propio.
FRONTEND_ORIGIN=http://localhost:3000
# lax (por defecto; vale en Vercel, donde frontend y backend comparten dominio)
# | none (requerido si el frontend está en otro dominio con HTTPS) | strict
COOKIE_SAME_SITE=lax
# debug | info | warn | error | silencioso
LOG_LEVEL=info

# Firma de las cookies de sesión: 32+ caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si falta, el backend usa uno temporal y las sesiones se pierden al reiniciar.
SESSION_SECRET=
# Segundos que una sala debe estar vacía para cerrarse (F13). Para una demo rápida, prueba 30.
SALA_CIERRE_SEGUNDOS=180

# Salas con varias instancias del backend (Vercel): Redis comparte presencias y eventos.
# Vacío = salas en la memoria de un solo backend (solo desarrollo). En producción y en Vercel es
# obligatorio. Local: redis://localhost:6379 (npm run redis:local). Proveedor: rediss://… (TLS).
# Es privada: nunca con prefijo NEXT_PUBLIC_.
REDIS_URL=
# Prefijo de claves y canales; distinto por entorno si comparten un mismo Redis (p. ej. vista-previa:).
REDIS_PREFIJO=comunidad:
# Latido (ping del WebSocket y renovación de presencias) y vida de una presencia sin renovar:
# el margen para reconectarse sin salir de la sala. La presencia debe ser al menos 2 latidos.
SALAS_LATIDO_SEGUNDOS=10
SALAS_PRESENCIA_SEGUNDOS=30

# Asistentes IA del panel y de orientación (la variable `openai` existente también se reutiliza).
# Si ya tienes `openai` configurada en tu .env, no necesitas duplicar la API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# PostgreSQL. En Supabase usa el pooler en modo sesión (puerto 5432), sin "?sslmode=...".
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres
# disable (Postgres local) | require (cifrado, sin verificar certificado) | verify-full
DATABASE_SSL=require

# ── Frontend ─────────────────────────────────────────────────────────
# En Vercel se ignora: el backend se sirve en el mismo dominio, bajo /api y /ws.
NEXT_PUBLIC_API_URL=http://localhost:4000
